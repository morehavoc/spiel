<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for Spiel.app (scripts/release.sh). Exactly one:
  the microphone. Under the hardened runtime, capture fails without it even with
  the TCC grant. Nothing else is needed:
    * paste (TextInserter) is the Accessibility API + a CGEvent Cmd+V, both gated
      by the Accessibility TCC grant, not by an entitlement; no Apple Events.
    * CoreML / the Neural Engine (FluidAudio) needs no JIT or unsigned memory.
    * Sparkle.framework is signed with the same Developer ID team, so library
      validation stays on.
  The `spiel` helper gets none: it reads files, never the mic.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
